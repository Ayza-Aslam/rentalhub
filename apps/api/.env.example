# Copy this file to ".env" and fill in your own real values.
# ".env" is git-ignored, so your real credentials never get committed.

# Connection string for your PostgreSQL database (e.g. from Neon, Supabase, or local Postgres).
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"
